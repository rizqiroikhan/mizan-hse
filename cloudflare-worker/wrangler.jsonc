/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mizan-hse-staging-7cf7",
	"account_id": "cc6aae0a56b993ecc2608bfcbdee315d",
	"main": "src/entry.py",
	"compatibility_date": "2026-09-25",
	"compatibility_flags": [
		"python_workers"
	],
	"assets": {
		// The path to the directory containing the `index.html` file to be served at `/`
		"directory": "./public",
		"run_worker_first": ["/api/*"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mizan-hse-staging",
			"database_id": "00000000-0000-0000-0000-000000000002",
			"migrations_dir": "./migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "EVIDENCE",
			"bucket_name": "mizan-hse-evidence-local"
		}
	],
	"vars": {
		"MIZAN_ENV": "development",
		"MIZAN_STORAGE_BACKEND": "r2"
	},
	"env": {
		"staging": {
			"name": "mizan-hse-staging-7cf7",
			"routes": [{ "pattern": "hse.ssnai.org/*", "zone_name": "ssnai.org" }],
			"vars": { "MIZAN_ENV": "staging", "MIZAN_STORAGE_BACKEND": "supabase", "SUPABASE_BUCKET": "mizan-hse-evidence-staging" },
			"d1_databases": [{ "binding": "DB", "database_name": "mizan-hse-staging-ssnai", "database_id": "5f2cb7aa-fa13-48bb-8779-41c47ce0c021", "migrations_dir": "./migrations" }],
			"r2_buckets": []
		},
		"production": {
			"vars": { "MIZAN_ENV": "production", "MIZAN_STORAGE_BACKEND": "supabase", "SUPABASE_BUCKET": "REPLACE_WITH_PRODUCTION_SUPABASE_BUCKET" },
			"d1_databases": [{ "binding": "DB", "database_name": "mizan-hse-production", "database_id": "REPLACE_WITH_PRODUCTION_D1_ID", "migrations_dir": "./migrations" }],
			"r2_buckets": []
		}
	},
	"observability": {
		"enabled": true
	}
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
